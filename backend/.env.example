# ── Nankara Shop API — environment ──
# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=development

# PostgreSQL (SQLAlchemy + psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://nankara:nankara@localhost:5433/nankara

# Signing secret for session cookies — generate with: openssl rand -hex 32
# In production the app REFUSES TO START if this is the default or shorter than 32 chars.
SECRET_KEY=change-me-in-production
ADMIN_TOKEN_TTL_MINUTES=720        # admin session cookie lifetime (12h)
CUSTOMER_TOKEN_TTL_MINUTES=43200   # customer session cookie lifetime (30d)

# Comma-separated allowed browser origins (the Next.js frontend). Used for CORS,
# the same-origin CSRF check, and (in prod) the startup safety guard — must NOT be
# localhost in production.
CORS_ORIGINS=http://localhost:3000

# Cloudinary — product image storage/CDN
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=nankara/products

# Paystack — the only MVP payment gateway (spec §13). Secret key stays server-side.
# Test keys from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Where the Paystack callback returns the customer (the Next.js app origin).
FRONTEND_ORIGIN=http://localhost:3000

# Resend — transactional email (account verification, password reset, and
# contact/consultation notifications to the admin). Optional in dev: when unset
# those flows still succeed and just skip sending. Form notifications go to the
# oldest active admin's email — with the default resend.dev sender that only
# works if that admin address is your Resend account address.
RESEND_API_KEY=
RESEND_FROM=Nankara <onboarding@resend.dev>
# Customer session cookie lifetime is CUSTOMER_TOKEN_TTL_MINUTES (see above).
# FRONTEND_ORIGIN builds the links in verification / reset emails.
# COOKIE_DOMAIN only when the API is a sibling subdomain of the frontend
# (e.g. COOKIE_DOMAIN=.nankara.com). Leave blank when the frontend proxies /api/v1/*.
COOKIE_DOMAIN=

# ── Reserved for later milestones (not used yet) ──
# NGN_PER_USD=1600
